{
  "name": "ism-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the ACSC Information Security Manual (ISM). Serves all historical, current, and future ISM releases via the official OSCAL data feed.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ism-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -w -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --test --import tsx tests/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ism",
    "acsc",
    "asd",
    "oscal",
    "cybersecurity",
    "australia"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
